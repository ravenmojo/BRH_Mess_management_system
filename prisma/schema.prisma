generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FacilityType {
  REGULAR_MESS
  NIGHT_CANTEEN
  MAINTENANCE_WASHROOM
  MAINTENANCE_WATER
  MAINTENANCE_ELECTRICAL
  MAINTENANCE_CIVIL
  MAINTENANCE_CLEANING
  MAINTENANCE_OUTDOOR
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  NIGHT_SNACK
}

model Item {
  id           String       @id @default(uuid())
  name         String
  price        Float
  category     String       // e.g. "Breakfast", "Lunch Veg", "Lunch Non-Veg", "Salad", "Beverage"
  facilityType FacilityType @default(REGULAR_MESS)
  isMandatory  Boolean      @default(false)
  isSalad      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  menuItems    MenuItem[]
}

model DailyMenu {
  id           String       @id @default(uuid())
  dayOfWeek    String       // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
  facilityType FacilityType @default(REGULAR_MESS)
  totalCost    Float        @default(0.0)
  items        MenuItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([dayOfWeek, facilityType])
}

model MenuItem {
  id          String     @id @default(uuid())
  dailyMenuId String
  dailyMenu   DailyMenu  @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item       @relation(fields: [itemId], references: [id])
  mealType    MealType
  price       Float      // Price snapshot for this meal item
  optionGroup String     @default("Common") // Common, Option 1, Option 2, Veg, Non-Veg
  createdAt   DateTime   @default(now())
}

model Feedback {
  id           String       @id @default(uuid())
  studentName  String
  hallRoll     String
  roomNo       String?
  email        String?
  comment      String
  facilityType FacilityType @default(REGULAR_MESS)
  status       String       @default("PENDING") // PENDING, RESOLVED
  remark       String?
  mediaUrl     String?      // Cloudinary URL for uploaded photos/videos
  capturedAt   String?      // Picture metadata capture timestamp
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("STUDENT") // STUDENT, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- NEW MODELS FOR BRH HALL MANAGEMENT ---

model Poll {
  id        String       @id @default(uuid())
  month     Int
  year      Int
  isActive  Boolean      @default(true)
  options   PollOption[]
  votes     PollVote[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([month, year])
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  itemName  String
  votes     PollVote[]
}

model PollVote {
  id           String     @id @default(uuid())
  pollId       String
  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  rollNo       String     // To prevent multiple votes per student
  createdAt    DateTime   @default(now())

  @@unique([pollId, rollNo]) // One vote per poll per student
}

model GalleryImage {
  id             String   @id @default(uuid())
  url            String
  caption        String?
  category       String   @default("GENERAL") // e.g. "CLEANING", "RAW_MATERIALS", "WEIGHT_CHECK", "PACKAGING"
  uploaderName   String?
  uploaderRollNo String?
  capturedAt     String?  // Picture metadata capture timestamp
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())
}

model MovieScreening {
  id        String   @id @default(uuid())
  title     String
  posterUrl String
  showTime  DateTime
  venue     String   @default("Common Room")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Suggestion {
  id          String   @id @default(uuid())
  studentName String
  hallRoll    String
  category    String   // MESS, MAINTENANCE, ACTIVITIES, OTHER
  content     String
  createdAt   DateTime @default(now())
}

model ActivityParticipant {
  id          String   @id @default(uuid())
  studentName String
  hallRoll    String
  activity    String   // MUSIC, ARTS, SPORTS, etc.
  createdAt   DateTime @default(now())
}

model WingFeedback {
  id               String   @id @default(uuid())
  wing             String
  representative   String
  feedbackContent  String
  createdAt        DateTime @default(now())
}

model Achievement {
  id          String   @id @default(uuid())
  studentName String
  hallRoll    String?
  title       String
  description String
  category    String   // ACADEMICS, SPORTS, CULTURAL, etc.
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model EmergencyContact {
  id        String   @id @default(uuid())
  role      String
  name      String
  phone     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

